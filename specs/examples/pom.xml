<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.atomikos</groupId>
	<version>6.0.2-SNAPSHOT</version>
	<artifactId>examples</artifactId>
	<packaging>pom</packaging>
	<name>Atomikos Examples</name>


	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId> <!-- Required to avoid using the default 2.1 version which is buggy -->
				<artifactId>maven-release-plugin</artifactId>
				<version>2.5.3</version>
			</plugin>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>2.3.2</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>2.9</version>
				<configuration>
					<skip>true</skip> <!-- javadoc plugin complains on Java 8 and we don't really need to generate it for the examples -->
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<id>enforce-java</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>1.8</version>
								</requireJavaVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>2.3</version>
				<configuration>
					<descriptorRefs>
						<descriptorRef>project</descriptorRef>
					</descriptorRefs>
				</configuration>
				<executions>
					<execution>
						<id>make-assembly</id>
						<phase>package</phase> <!-- bind to the packaging phase -->
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<forkCount>0</forkCount>
					<argLine>-Xmx512m</argLine>
					<workingDirectory>${project.build.directory} </workingDirectory>
				</configuration>
			</plugin>
			<!--
			  Enforces ADR-005: every active module below must also
			  have a one-line INDEX entry in README.TXT. The check is
			  in specs/architecture/skills/examples-index-check/scripts/check.py
			  and exits non-zero in strict mode if any module is missing.
			-->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>examples-index-check</id>
						<phase>validate</phase>
						<goals><goal>exec</goal></goals>
						<inherited>false</inherited>
						<configuration>
							<executable>python3</executable>
							<workingDirectory>${project.basedir}/../..</workingDirectory>
							<arguments>
								<argument>specs/architecture/skills/examples-index-check/scripts/check.py</argument>
								<argument>--strict</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<extensions>
			<!-- Enabling the use of FTP -->
			<extension>
				<groupId>org.apache.maven.wagon</groupId>
				<artifactId>wagon-ftp</artifactId>
				<version>3.2.0</version>
			</extension>
		</extensions>
	</build>

	<modules>
		<module>examples-jta</module>
		<module>examples-jta-spring</module>
		<module>examples-hibernate4</module>
		<module>examples-hibernate5</module>
		<module>examples-jpa</module>
		<module>examples-hibernate4-jndi</module>
		<module>examples-hibernate-jndi-spring</module>
		<module>examples-jta-rest-jaxrs</module>
		<module>examples-jta-dubbo</module>
		<module>examples-jta-grpc</module>
		<!--  <module>osgi</module> -->
    	<module>examples-hibernate6</module>
    	<module>examples-jta-spring-jakarta</module>
    	<module>examples-hibernate7</module>
    	<module>examples-jta-jakarta</module>
	</modules>
	<distributionManagement>
		<repository>
			<id>atomikos.website.axt.downloads</id>
			<url>ftp://www.atomikos.com</url>
		</repository>
		<snapshotRepository>
			<id>internal.snapshot.repo</id>
			<name>Atomikos Internal Snapshot Repository</name>
			<url>file://${user.home}/.m2/repository</url>
		</snapshotRepository>
	</distributionManagement>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.atomikos</groupId>
				<artifactId>transactions-hibernate4</artifactId>
				<version>6.0.2-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.atomikos</groupId>
				<artifactId>transactions-jndi-provider</artifactId>
				<version>6.0.2-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.atomikos</groupId>
				<artifactId>transactions-hibernate3</artifactId>
				<version>6.0.2-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.atomikos</groupId>
				<artifactId>transactions-hibernate4</artifactId>
				<version>6.0.2-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.atomikos</groupId>
				<artifactId>transactions-jdbc</artifactId>
				<version>6.0.2-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.atomikos</groupId>
				<artifactId>transactions-jms</artifactId>
				<version>6.0.2-SNAPSHOT</version>
			</dependency>
                        <dependency>
                                <groupId>com.atomikos</groupId>
                                <artifactId>transactions-jta</artifactId>
                                <version>6.0.2-SNAPSHOT</version>
                        </dependency>
			<dependency>
				<groupId>com.atomikos</groupId>
				<artifactId>transactions-remoting</artifactId>
				<version>6.0.2-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.atomikos</groupId>
				<artifactId>transactions-osgi</artifactId>
				<version>6.0.2-SNAPSHOT</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<profiles>
		<profile>
			<id>local</id>
			<build>
				<plugins>
					<plugin>
						<artifactId>maven-release-plugin</artifactId>
						<configuration>
							<pushChanges>false</pushChanges>
							<localCheckout>true</localCheckout>
						</configuration>
					</plugin>
					<plugin>
						<artifactId>maven-deploy-plugin</artifactId>
						<configuration>
							<skip>true</skip>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		 <profile>
                        <activation>
                                <jdk>[1.9,)</jdk>
                        </activation>
                        <build>
                                <plugins>
                                        <plugin>
                                                <artifactId>maven-surefire-plugin</artifactId>
                                                <configuration>
                                                        <forkCount>0</forkCount>
                                                        <argLine>-Xmx512m --add-modules java.sql</argLine>
                                                        <workingDirectory>${project.build.directory} </workingDirectory>
                                                </configuration>
                                        </plugin>
                                </plugins>
                        </build>
                </profile>

	</profiles>
	<dependencies>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>1.7.21</version>
		</dependency>
	</dependencies>
</project>
